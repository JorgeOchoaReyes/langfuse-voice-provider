{
  "name": "langfuse-voice-provider",
  "version": "0.1.0",
  "description": "Keep voice-agent prompts (Retell, ElevenLabs, Vapi) and Langfuse prompt management continuously in sync.",
  "keywords": [
    "langfuse",
    "retell",
    "elevenlabs",
    "vapi",
    "voice-agents",
    "prompt-management",
    "observability",
    "llmops"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.js"
    }
  },
  "bin": {
    "langfuse-voice": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:test": "tsc -p tsconfig.json",
    "clean": "rm -rf dist dist-test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build:test && node --test dist-test/test/*.test.js",
    "start": "node dist/cli.js watch",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JorgeOchoaReyes/langfuse-voice-provider.git"
  }
}
