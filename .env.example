# Langfuse -------------------------------------------------------------------
# Project settings -> API keys. Self-hosted? point LANGFUSE_BASE_URL at your host.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# Voice providers ------------------------------------------------------------
# Only the ones you actually bind to are required.
RETELL_API_KEY=
ELEVENLABS_API_KEY=
# Vapi: this must be the PRIVATE key. The public key cannot read assistants.
VAPI_API_KEY=

# Server ---------------------------------------------------------------------
# Until this is set, POST /sync and POST /webhooks/* reject every request.
WEBHOOK_SECRET=
PORT=8080
LOG_LEVEL=info
